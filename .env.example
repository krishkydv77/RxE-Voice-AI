# ---- API keys (zaroori) ----
GROQ_API_KEY=
SARVAM_API_KEY=
SERPAPI_API_KEY=

# ---- Models (optional) ----
GROQ_MODEL=qwen/qwen3.8-27b
SARVAM_STT_MODEL=saarika:v2.5
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh

# ---- RAG (optional) ----
DATA_DIR=data_basic
VECTOR_DIR=vectordb
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
CHUNK_SIZE=500
CHUNK_OVERLAP=80
TOP_K=3

# ---- Bot behaviour (optional) ----
REPLY_MAX_WORDS=30
LLM_MAX_TOKENS=160
LLM_REASONING_EFFORT=low   # sirf gpt-oss models ke liye
EMERGENCY_NUMBER=112
CORE_TARGET_MS=2000
SERPAPI_TIMEOUT=5

# ---- MCP ----
USE_MCP=1                     # 1 = tools mcp_server.py ke through (pehle usse chalayein), 0 = in-process
MCP_SERVER_URL=http://127.0.0.1:8001/mcp

# ---- Logging ----
LOG_DIR=logs
LOG_LEVEL=INFO

# ---- Server ----
HOST=0.0.0.0
PORT=8000
